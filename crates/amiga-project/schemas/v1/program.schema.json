{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amiga-re.invalid/schemas/project/v1/program.schema.json",
  "title": "One program: its images, hunks, and named load maps",
  "description": "A program groups the modules of one executable system. An image is the parsed view of one object, and it may have several *named* load maps \u2014 alternate versions, boot-loaded regions, overlays \u2014 because no single address is universally true for a relocatable Amiga executable.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "document_kind",
    "format_version",
    "id",
    "name",
    "images"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "document_kind": {
      "const": "program"
    },
    "format_version": {
      "$ref": "https://amiga-re.invalid/schemas/project/v1/common.schema.json#/$defs/formatVersion"
    },
    "id": {
      "$ref": "https://amiga-re.invalid/schemas/project/v1/common.schema.json#/$defs/id"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "source_set_id": {
      "$ref": "https://amiga-re.invalid/schemas/project/v1/common.schema.json#/$defs/id"
    },
    "notes": {
      "$ref": "https://amiga-re.invalid/schemas/project/v1/common.schema.json#/$defs/notes"
    },
    "images": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "object_id",
          "format",
          "architecture"
        ],
        "properties": {
          "id": {
            "$ref": "https://amiga-re.invalid/schemas/project/v1/common.schema.json#/$defs/id"
          },
          "object_id": {
            "$ref": "https://amiga-re.invalid/schemas/project/v1/common.schema.json#/$defs/id"
          },
          "format": {
            "type": "string",
            "enum": [
              "hunk",
              "raw",
              "bootblock"
            ]
          },
          "architecture": {
            "type": "string",
            "enum": [
              "mc68000"
            ]
          },
          "load_maps": {
            "type": "array",
            "maxItems": 256,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "name",
                "segments"
              ],
              "properties": {
                "id": {
                  "$ref": "https://amiga-re.invalid/schemas/project/v1/common.schema.json#/$defs/id"
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "segments": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 65536,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "hunk",
                      "runtime_base"
                    ],
                    "properties": {
                      "hunk": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 65535
                      },
                      "runtime_base": {
                        "$ref": "https://amiga-re.invalid/schemas/project/v1/common.schema.json#/$defs/hexAddress"
                      }
                    }
                  }
                },
                "entry_points": {
                  "type": "array",
                  "maxItems": 4096,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "address",
                      "role"
                    ],
                    "properties": {
                      "address": {
                        "$ref": "https://amiga-re.invalid/schemas/project/v1/common.schema.json#/$defs/hexAddress"
                      },
                      "role": {
                        "type": "string",
                        "enum": [
                          "program_entry",
                          "interrupt",
                          "library_vector",
                          "discovered"
                        ]
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "extensions": {
      "$ref": "https://amiga-re.invalid/schemas/project/v1/common.schema.json#/$defs/extensions"
    }
  }
}
