      "id": "type:load-level-signature",
      "kind": "function",
      "name": "LoadLevelSignature",
      "notes": "Nothing here is a convention. The routine takes its selector in D1 and a destination in A2 because that is what it was observed to read; a C compiler would have used neither. `preserves` is absent rather than empty, which says the rest of the register file has not been reviewed — not that it survives.",
      "parameters": [
        {
          "location": {
            "kind": "register",
            "register": "d1"
          },
          "name": "level",
          "type_id": "type:u16"
        },
        {
          "location": {
            "kind": "register",
            "register": "a2"
          },
          "name": "destination",
          "type_id": "type:level-ptr"
        },
        {
          "location": {
            "kind": "stack",
            "offset": 4
          },
          "name": "flags",
          "notes": "Pushed by the caller, so it is at 4 rather than 0: the return address is at (a7) on entry.",
          "type_id": "type:level-flags"
        }
      ],
      "results": [
        {
          "location": {
            "kind": "register",
            "register": "d0"
          },
          "name": "status",
          "type_id": "type:s16"
        },
        {
          "location": {
            "kind": "register",
            "register": "a0"
          },
          "name": "header",
          "notes": "The second result. A signature with one would have lost it.",
          "type_id": "type:level-ptr"
        }
      ]
    },
