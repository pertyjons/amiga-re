  "$defs": {
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "$ref": "#/$defs/executionMode"
        },
        "events": {
          "description": "`stream` is part of the version-1 shape but is not servable yet; a request asking for it is refused.",
          "type": "string",
          "enum": [
            "final_only",
            "stream"
          ],
          "default": "final_only"
        }
      }
    },
    "executionMode": {
      "description": "What the caller authorizes. A tagged union rather than a boolean, so committing a reviewed write plan carries the digest it was authorized against.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "read"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "prepare"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "approved_plan_sha256"
          ],
          "properties": {
            "kind": {
              "const": "commit_reviewed"
            },
            "approved_plan_sha256": {
              "$ref": "https://amiga-re.invalid/schemas/operations/v1/common.schema.json#/$defs/sha256"
            }
          }
        }
      ]
    }
  }
