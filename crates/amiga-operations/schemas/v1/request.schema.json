    },
    "request_id": {
      "$ref": "https://amiga-re.invalid/schemas/operations/v1/common.schema.json#/$defs/requestId"
    },
    "project": {
      "description": "Reserved for the versioned project format. Present from version 1 so the envelope does not need reshaping when projects land; until then every request carrying one is refused.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "path"
      ],
      "properties": {
        "kind": {
          "const": "path"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      }
    },
    "execution": {
      "$ref": "#/$defs/execution"
    },
    "request": {
      "description": "Exactly one operation, tagged by `operation`.",
