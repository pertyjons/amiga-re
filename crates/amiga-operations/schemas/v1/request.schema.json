  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amiga-re.invalid/schemas/operations/v1/request.schema.json",
  "title": "amiga-re operation request envelope, protocol version 1",
  "description": "Transport and authorization live here; what to do lives in `request`. The loader always selects this schema from `protocol_version` and never fetches one a request names.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "request"
  ],
