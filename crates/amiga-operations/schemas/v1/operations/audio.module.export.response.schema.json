{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amiga-re.invalid/schemas/operations/v1/operations/audio.module.export.response.schema.json",
  "title": "audio.module.export result",
  "description": "The module file that would be written, and whether it was, beside what it holds.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "module",
    "plan",
    "committed"
  ],
  "properties": {
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "offset",
        "title",
        "signature",
        "channels",
        "song_length",
        "pattern_count",
        "total_bytes",
        "module_sha256",
        "samples"
      ],
      "properties": {
        "source": {
          "$ref": "https://amiga-re.invalid/schemas/operations/v1/common.schema.json#/$defs/sourcePin"
        },
        "offset": {
          "description": "Byte offset the module starts at.",
          "type": "integer",
          "minimum": 0
        },
        "title": {
          "type": "string"
        },
        "signature": {
          "description": "The four-character format signature, e.g. M.K. or 6CHN.",
          "type": "string"
        },
        "channels": {
          "type": "integer",
          "minimum": 0
        },
        "song_length": {
          "type": "integer",
          "minimum": 0
        },
        "pattern_count": {
          "type": "integer",
          "minimum": 0
        },
        "total_bytes": {
          "description": "Total bytes the module occupies, header through sample data.",
          "type": "integer",
          "minimum": 0
        },
        "module_sha256": {
          "$ref": "https://amiga-re.invalid/schemas/operations/v1/common.schema.json#/$defs/sha256"
        },
        "samples": {
          "description": "Every sample slot, including unused ones with a zero length. A tracker addresses samples by slot number, so dropping the empty ones would renumber the rest.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "slot",
              "name",
              "length",
              "volume",
              "finetune",
              "repeat_start",
              "repeat_length"
            ],
            "properties": {
              "slot": {
                "description": "One-based slot number, as a tracker displays it.",
                "type": "integer",
                "minimum": 1
              },
              "name": {
                "type": "string"
              },
              "length": {
                "type": "integer",
                "minimum": 0
              },
              "volume": {
                "type": "integer",
                "minimum": 0
              },
              "finetune": {
                "type": "integer",
                "minimum": 0
              },
              "repeat_start": {
                "type": "integer",
                "minimum": 0
              },
              "repeat_length": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "plan": {
      "$ref": "https://amiga-re.invalid/schemas/operations/v1/common.schema.json#/$defs/writePlan"
    },
    "committed": {
      "type": "boolean"
    }
  }
}
