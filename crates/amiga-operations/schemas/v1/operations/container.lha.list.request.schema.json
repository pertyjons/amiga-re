{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amiga-re.invalid/schemas/operations/v1/operations/container.lha.list.request.schema.json",
  "title": "container.lha.list request",
  "description": "List an LHA archive's members and the method each is stored with, writing nothing. `read_only`.",
  "type": "object",
  "additionalProperties": false,
  "required": ["operation", "arguments"],
  "properties": {
    "operation": { "const": "container.lha.list" },
    "arguments": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source"],
      "properties": {
        "source": {
          "$ref": "https://amiga-re.invalid/schemas/operations/v1/common.schema.json#/$defs/sourceLocator"
        },
        "maximum_members": {
          "$ref": "https://amiga-re.invalid/schemas/operations/v1/common.schema.json#/$defs/resultCap"
        },
        "maximum_input_bytes": {
          "$ref": "https://amiga-re.invalid/schemas/operations/v1/common.schema.json#/$defs/maximumInputBytes",
          "default": 67108864
        }
      }
    }
  },
  "examples": [
    {
      "operation": "container.lha.list",
      "arguments": { "source": { "kind": "file", "path": "original/disk.lha" } }
    }
  ]
}
