{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amiga-re.invalid/schemas/operations/v1/operations/analysis.hunk.normalize.request.schema.json",
  "title": "analysis.hunk.normalize request",
  "description": "Report what rewriting a one-file loader's compact relocation records as standard ones would produce, writing nothing. `read_only`. An image that already parses is refused rather than rewritten.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operation",
    "arguments"
  ],
  "properties": {
    "operation": {
      "const": "analysis.hunk.normalize"
    },
    "arguments": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source"
      ],
      "properties": {
        "source": {
          "$ref": "https://amiga-re.invalid/schemas/operations/v1/common.schema.json#/$defs/sourceLocator"
        },
        "maximum_input_bytes": {
          "$ref": "https://amiga-re.invalid/schemas/operations/v1/common.schema.json#/$defs/maximumInputBytes",
          "default": 67108864
        }
      }
    }
  },
  "examples": [
    {
      "operation": "analysis.hunk.normalize",
      "arguments": {
        "source": {
          "kind": "file",
          "path": "extracted/loader"
        }
      }
    }
  ]
}
