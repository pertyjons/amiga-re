{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amiga-re.invalid/schemas/operations/v1/operations/env.sandbox.matrix.response.schema.json",
  "title": "env.sandbox.matrix result",
  "description": "Every case of the sweep, and the totals over them. The totals are stated rather than left to be counted, because they are what a sweep is read by: a reader who has to count three hundred entries to learn that two failed will not. Every case appears whatever became of it \u2014 a refusal or an unrun case that vanished would report a coverage the run did not have.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "base_recipe_sha256",
    "cases_total",
    "cases_ran",
    "cases_returned",
    "cases_refused",
    "cases_not_run",
    "steps_executed_total",
    "maximum_total_steps",
    "budget_exhausted",
    "cases"
  ],
  "properties": {
    "source": {
      "$ref": "https://amiga-re.invalid/schemas/operations/v1/common.schema.json#/$defs/sourcePin",
      "description": "The image every case ran over. Absent only when no case ran \u2014 and the result is still returned then, carrying every case's own refusal, because a matrix that answered with nothing because nothing succeeded would lose the diagnostics that say why."
    },
    "hunk": {
      "description": "Which CODE hunk the cases ran. Absent for the same reason `source` is, and not defaulted to zero: hunk 0 is a real answer, and reporting it for a matrix that ran nothing would be a fact nothing established.",
      "type": "integer",
      "minimum": 0
    },
    "base_recipe_sha256": {
      "description": "The shared recipe's digest. Every case's digest differs from it and from each other's; this is what says which experiment they are cases of.",
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "cases_total": {
      "type": "integer",
      "minimum": 0
    },
    "cases_ran": {
      "description": "Cases that executed, whether or not they returned cleanly.",
      "type": "integer",
      "minimum": 0
    },
    "cases_returned": {
      "description": "Cases that ran and returned cleanly \u2014 the count a caller checks.",
      "type": "integer",
      "minimum": 0
    },
    "cases_refused": {
      "description": "Cases refused before executing anything.",
      "type": "integer",
      "minimum": 0
    },
    "cases_not_run": {
      "description": "Cases never attempted because the aggregate budget was spent.",
      "type": "integer",
      "minimum": 0
    },
    "steps_executed_total": {
      "type": "integer",
      "minimum": 0
    },
    "maximum_total_steps": {
      "description": "The aggregate budget this matrix ran under, after clamping.",
      "type": "integer",
      "minimum": 0
    },
    "budget_exhausted": {
      "type": "boolean"
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "recipe_sha256",
          "outcome",
          "returned",
          "steps_executed",
          "changed_regions",
          "changed_regions_total",
          "changed_regions_truncated",
          "exported_regions",
          "diagnostics"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "recipe_sha256": {
            "description": "The digest of this case's own normalized request, not the matrix's. A case can therefore be cited, re-run through env.sandbox.call, and shown to be the same recipe \u2014 which is what makes a matrix a set of ordinary calls rather than a second execution path.",
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "outcome": {
            "description": "`ran` executed; `refused` was rejected before executing anything, with the reason in `diagnostics`; `not_run` was never attempted because the matrix's aggregate step budget was already too small for this case's own. The last is not a refusal \u2014 nothing is wrong with the case, and the remedy is a larger budget rather than a fixed request.",
            "enum": [
              "ran",
              "refused",
              "not_run"
            ]
          },
          "notes": {
            "type": "string"
          },
          "entry": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          },
          "inputs": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "d",
              "a",
              "usp",
              "ssp",
              "pc",
              "sr"
            ],
            "properties": {
              "d": {
                "type": "array",
                "minItems": 8,
                "maxItems": 8,
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 4294967295
                }
              },
              "a": {
                "type": "array",
                "minItems": 7,
                "maxItems": 7,
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 4294967295
                }
              },
              "usp": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4294967295
              },
              "ssp": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4294967295
              },
              "pc": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4294967295
              },
              "sr": {
                "type": "integer",
                "minimum": 0,
                "maximum": 65535
              }
            }
          },
          "outputs": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "d",
              "a",
              "usp",
              "ssp",
              "pc",
              "sr"
            ],
            "properties": {
              "d": {
                "type": "array",
                "minItems": 8,
                "maxItems": 8,
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 4294967295
                }
              },
              "a": {
                "type": "array",
                "minItems": 7,
                "maxItems": 7,
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 4294967295
                }
              },
              "usp": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4294967295
              },
              "ssp": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4294967295
              },
              "pc": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4294967295
              },
              "sr": {
                "type": "integer",
                "minimum": 0,
                "maximum": 65535
              }
            }
          },
          "stop": {
            "description": "Why the run stopped. Every variant is a distinct fact about the code, not a shade of failure.",
            "type": "object",
            "required": [
              "reason"
            ],
            "properties": {
              "reason": {
                "type": "string",
                "enum": [
                  "returned",
                  "step_limit",
                  "stopped",
                  "fault",
                  "trap",
                  "watch",
                  "unhandled_call"
                ]
              },
              "address": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4294967295
              },
              "access": {
                "type": "string",
                "enum": [
                  "read",
                  "write"
                ]
              },
              "size": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4
              },
              "site": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4294967295
              },
              "vector": {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              },
              "offset": {
                "description": "The signed library-vector offset. Naming it against an fd table is the frontend's, because the tables are its configuration.",
                "type": "integer"
              }
            }
          },
          "returned": {
            "description": "Whether the routine returned cleanly. False for a case that did not run, which is why `outcome` is what a reader counts rather than this.",
            "type": "boolean"
          },
          "steps_executed": {
            "type": "integer",
            "minimum": 0
          },
          "changed_regions": {
            "description": "Every run of memory this case changed, digested rather than carried: three hundred cases carrying their changed memory is a response nobody can read and a size nobody bounded. The digest is what two cases are compared by, and env.sandbox.call on the case's own recipe is what produces the bytes when one of them turns out to matter.",
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "address",
                "length",
                "sha256"
              ],
              "properties": {
                "address": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 4294967295
                },
                "length": {
                  "type": "integer",
                  "minimum": 0
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          },
          "changed_regions_total": {
            "type": "integer",
            "minimum": 0
          },
          "changed_regions_truncated": {
            "type": "boolean"
          },
          "exported_regions": {
            "description": "Every range of final memory the recipe named, digested rather than carried. A recipe plus a digest reproduces the bytes and is bounded; the bytes themselves are what `env.sandbox.call.export` writes.",
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "address",
                "length",
                "sha256",
                "capture_note"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "address": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 4294967295
                },
                "length": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 4294967295
                },
                "sha256": {
                  "$ref": "https://amiga-re.invalid/schemas/operations/v1/common.schema.json#/$defs/sha256"
                },
                "capture_note": {
                  "description": "What produced these bytes, as one sentence, for `project.edit`'s `register_capture` to record. Composed here rather than by whoever registers it: a capture is bytes no one can obtain again, so this note is the only provenance they will ever have, and a person writing it from memory writes prose that happens to be true. Deterministic \u2014 the same recipe over the same bytes composes the same sentence.",
                  "type": "string"
                }
              }
            }
          },
          "diagnostics": {
            "description": "Why this case was refused, or what it warned about. Kept per case so one case's finding is not attributed to the matrix or to its neighbour.",
            "type": "array",
            "items": {
              "$ref": "https://amiga-re.invalid/schemas/operations/v1/diagnostic.schema.json"
            }
          }
        }
      }
    }
  }
}
