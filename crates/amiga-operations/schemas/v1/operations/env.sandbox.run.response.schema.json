{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amiga-re.invalid/schemas/operations/v1/operations/env.sandbox.run.response.schema.json",
  "title": "env.sandbox.run result",
  "description": "How the run ended, the memory map its addresses mean, and the trace it kept.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source",
    "hunk",
    "load_origin",
    "allocation_bytes",
    "entry",
    "stack_base",
    "stack_top",
    "steps_executed",
    "stop",
    "registers",
    "trace",
    "trace_total",
    "trace_truncated",
    "watch_events_total",
    "watch_events_truncated",
    "writes",
    "writes_total",
    "writes_truncated"
  ],
  "properties": {
    "source": {
      "$ref": "https://amiga-re.invalid/schemas/operations/v1/common.schema.json#/$defs/sourcePin"
    },
    "hunk": {
      "type": "integer",
      "minimum": 0
    },
    "load_origin": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "allocation_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "entry": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "stack_base": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "stack_top": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "steps_executed": {
      "description": "Instructions executed, whether or not a trace was kept.",
      "type": "integer",
      "minimum": 0
    },
    "stop": {
      "description": "Why the run stopped. Every variant is a distinct fact about the code, not a shade of failure.",
      "type": "object",
      "required": [
        "reason"
      ],
      "properties": {
        "reason": {
          "type": "string",
          "enum": [
            "returned",
            "step_limit",
            "stopped",
            "fault",
            "trap",
            "watch",
            "unhandled_call"
          ]
        },
        "address": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "access": {
          "type": "string",
          "enum": [
            "read",
            "write"
          ]
        },
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "site": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "vector": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "offset": {
          "description": "The signed library-vector offset. Naming it against an fd table is the frontend's, because the tables are its configuration.",
          "type": "integer"
        }
      }
    },
    "registers": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "d",
        "a",
        "usp",
        "ssp",
        "pc",
        "sr"
      ],
      "properties": {
        "d": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          }
        },
        "a": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          }
        },
        "usp": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "ssp": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "pc": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "sr": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        }
      }
    },
    "trace": {
      "description": "The per-instruction trace, capped. Empty when none was asked for.",
      "type": "array",
      "items": {
        "$ref": "https://amiga-re.invalid/schemas/operations/v1/common.schema.json#/$defs/sandboxStep"
      }
    },
    "trace_total": {
      "description": "Rows the run produced before the cap. Always the true total: a capped trace that read as a complete one would make a step limit look like a short routine.",
      "type": "integer",
      "minimum": 0
    },
    "trace_truncated": {
      "type": "boolean"
    },
    "watch_events_total": {
      "description": "Accesses that matched a watched range, counted across the whole run. Not the same as the number of watch_hits the trace carries: the trace is capped in rows, retention is capped in events, and an attached device can make one instruction produce more matching accesses than a run makes instructions. This is the true total either way.",
      "type": "integer",
      "minimum": 0
    },
    "watch_events_truncated": {
      "description": "Whether more accesses matched than were retained, so the watch_hits on the trace rows are a prefix rather than the whole set.",
      "type": "boolean"
    },
    "writes": {
      "description": "Every write the run made, capped. Reported whether or not a trace was kept: what a sandbox run changed is the answer even when how it got there was not asked for.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "address",
          "size",
          "value"
        ],
        "properties": {
          "address": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          },
          "size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4
          },
          "value": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          }
        }
      }
    },
    "writes_total": {
      "description": "Writes the run made before the cap. Always the true total.",
      "type": "integer",
      "minimum": 0
    },
    "writes_truncated": {
      "type": "boolean"
    }
  }
}
