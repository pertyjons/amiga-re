{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amiga-re.invalid/schemas/operations/v1/operations/hardware.copper.scan.request.schema.json",
  "title": "hardware.copper.scan request",
  "description": "Find plausible Copper lists and the palettes and pointers each carries, writing nothing. `read_only`.",
  "type": "object",
  "additionalProperties": false,
  "required": ["operation", "arguments"],
  "properties": {
    "operation": { "const": "hardware.copper.scan" },
    "arguments": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source"],
      "properties": {
        "source": {
          "$ref": "https://amiga-re.invalid/schemas/operations/v1/common.schema.json#/$defs/sourceLocator"
        },
        "maximum_lists": {
          "$ref": "https://amiga-re.invalid/schemas/operations/v1/common.schema.json#/$defs/resultCap"
        },
        "maximum_input_bytes": {
          "$ref": "https://amiga-re.invalid/schemas/operations/v1/common.schema.json#/$defs/maximumInputBytes",
          "default": 67108864
        }
      }
    }
  },
  "examples": [
    {
      "operation": "hardware.copper.scan",
      "arguments": { "source": { "kind": "file", "path": "extracted/screen.bin" } }
    }
  ]
}
