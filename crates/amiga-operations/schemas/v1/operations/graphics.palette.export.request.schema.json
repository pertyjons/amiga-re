{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amiga-re.invalid/schemas/operations/v1/operations/graphics.palette.export.request.schema.json",
  "title": "graphics.palette.export request",
  "description": "Read a palette exactly as `graphics.palette.decode` does, then draw it as a swatch PNG. `prepared_output`: accepts only `prepare` and `commit_reviewed`.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operation",
    "arguments"
  ],
  "properties": {
    "operation": {
      "const": "graphics.palette.export"
    },
    "arguments": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "count",
        "destination"
      ],
      "properties": {
        "source": {
          "$ref": "https://amiga-re.invalid/schemas/operations/v1/common.schema.json#/$defs/sourceLocator"
        },
        "offset": {
          "description": "Byte offset of the first colour word.",
          "type": "integer",
          "minimum": 0,
          "default": 0
        },
        "count": {
          "description": "How many colour words to read. Capped at 256, which is the indexed-PNG format's ceiling.",
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        },
        "maximum_input_bytes": {
          "$ref": "https://amiga-re.invalid/schemas/operations/v1/common.schema.json#/$defs/maximumInputBytes",
          "default": 67108864
        },
        "destination": {
          "description": "Directory the swatch PNG goes in, as an identity the adapter resolves against its own output root.",
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$)).+$"
        },
        "file_name": {
          "description": "File name within the destination: one relative path component.",
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[^/]+$",
          "default": "palette.png"
        },
        "block": {
          "description": "Side of one swatch square, in pixels.",
          "type": "integer",
          "minimum": 1,
          "default": 16
        },
        "columns": {
          "description": "Swatches per row.",
          "type": "integer",
          "minimum": 1,
          "default": 8
        },
        "policy": {
          "$ref": "https://amiga-re.invalid/schemas/operations/v1/common.schema.json#/$defs/outputPolicy",
          "default": "create_only"
        }
      }
    }
  },
  "examples": [
    {
      "operation": "graphics.palette.export",
      "arguments": {
        "source": {
          "kind": "file",
          "path": "extracted/game.bin"
        },
        "offset": 8192,
        "count": 32,
        "destination": "images",
        "file_name": "title.palette.png"
      }
    }
  ]
}
