{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amiga-re.invalid/schemas/operations/v1/operations/analysis.hunk.list.request.schema.json",
  "title": "analysis.hunk.list request",
  "description": "List a LoadSeg image's hunks and the relocations between them, writing nothing. `read_only`.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operation",
    "arguments"
  ],
  "properties": {
    "operation": {
      "const": "analysis.hunk.list"
    },
    "arguments": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source"
      ],
      "properties": {
        "source": {
          "$ref": "https://amiga-re.invalid/schemas/operations/v1/common.schema.json#/$defs/sourceLocator"
        },
        "maximum_relocations": {
          "description": "Cap on the relocations reported per hunk. Each hunk always reports its true total beside the capped list.",
          "$ref": "https://amiga-re.invalid/schemas/operations/v1/common.schema.json#/$defs/resultCap"
        },
        "maximum_input_bytes": {
          "$ref": "https://amiga-re.invalid/schemas/operations/v1/common.schema.json#/$defs/maximumInputBytes",
          "default": 67108864
        }
      }
    }
  },
  "examples": [
    {
      "operation": "analysis.hunk.list",
      "arguments": {
        "source": {
          "kind": "file",
          "path": "extracted/game"
        }
      }
    }
  ]
}
