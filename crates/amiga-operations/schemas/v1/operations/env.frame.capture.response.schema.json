{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amiga-re.invalid/schemas/operations/v1/operations/env.frame.capture.response.schema.json",
  "title": "env.frame.capture result",
  "description": "The picture the display would have shown, and where each band of it came from. The intervals are what make a double-buffered or Copper-driven frame readable: each names the bitplane pointers and the palette that produced its band.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source",
    "hunk",
    "entry",
    "stop",
    "steps_executed",
    "width",
    "height",
    "planes",
    "indices",
    "indices_sha256",
    "pixel_sources",
    "pixel_sources_sha256",
    "rgba_sha256",
    "intervals",
    "registers"
  ],
  "properties": {
    "source": {
      "$ref": "https://amiga-re.invalid/schemas/operations/v1/common.schema.json#/$defs/sourcePin"
    },
    "hunk": {
      "type": "integer",
      "minimum": 0
    },
    "entry": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "stop": {
      "description": "Why the run stopped. Every variant is a distinct fact about the code, not a shade of failure.",
      "type": "object",
      "required": [
        "reason"
      ],
      "properties": {
        "reason": {
          "type": "string",
          "enum": [
            "returned",
            "step_limit",
            "stopped",
            "fault",
            "trap",
            "watch",
            "unhandled_call"
          ]
        },
        "address": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "access": {
          "type": "string",
          "enum": [
            "read",
            "write"
          ]
        },
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "site": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "vector": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "offset": {
          "description": "The signed library-vector offset. Naming it against an fd table is the frontend's, because the tables are its configuration.",
          "type": "integer"
        }
      }
    },
    "steps_executed": {
      "type": "integer",
      "minimum": 0
    },
    "width": {
      "type": "integer",
      "minimum": 0
    },
    "height": {
      "type": "integer",
      "minimum": 0
    },
    "planes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 6
    },
    "indices": {
      "description": "One palette index per pixel, row-major, hex-encoded. Preserved beside the RGBA rather than instead of it: an index is what the program wrote and a colour is only what one palette made of it, so a comparison that had lost the indices could not tell a palette change from a geometry change.",
      "type": "string",
      "pattern": "^([0-9a-f]{2})*$"
    },
    "indices_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "pixel_sources": {
      "description": "One source code per pixel, row-major and hex-encoded: zero is the playfield, while 1-8 identify the winning sprite channel plus one.",
      "type": "string",
      "pattern": "^(0[0-8])*$"
    },
    "pixel_sources_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "rgba_sha256": {
      "description": "The digest of the RGBA the indices resolve to under the per-band palettes.",
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "intervals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "first_line",
          "last_line",
          "first_raster_line",
          "bitplanes",
          "sprites",
          "bplcon2",
          "palette"
        ],
        "properties": {
          "first_line": {
            "type": "integer",
            "minimum": 0
          },
          "last_line": {
            "type": "integer",
            "minimum": 0
          },
          "first_raster_line": {
            "description": "The raster line the band starts at, so it reads against a Copper listing, which counts in raster lines.",
            "type": "integer",
            "minimum": 0
          },
          "bitplanes": {
            "description": "The bitplane pointers this band was fetched through — the field that says which buffer a double-buffered program was showing.",
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            }
          },
          "sprites": {
            "description": "The eight sprite DMA pointers in force across this band.",
            "type": "array",
            "minItems": 8,
            "maxItems": 8,
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            }
          },
          "bplcon2": {
            "description": "Sprite/playfield priority in force across this band.",
            "type": "integer",
            "minimum": 0,
            "maximum": 65535
          },
          "palette": {
            "description": "The palette in force across this band, as RGB4 words.",
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            }
          }
        }
      }
    },
    "registers": {
      "description": "The display registers as the run left them, for a reader checking the geometry against the program rather than against this reconstruction.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bplcon0",
        "bplcon1",
        "bplcon2",
        "diwstrt",
        "diwstop",
        "ddfstrt",
        "ddfstop",
        "bpl1mod",
        "bpl2mod",
        "dmacon",
        "sprite_pointers"
      ],
      "properties": {
        "bplcon0": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "bplcon1": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "bplcon2": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "diwstrt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "diwstop": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "ddfstrt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "ddfstop": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "dmacon": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "bpl1mod": {
          "type": "integer"
        },
        "bpl2mod": {
          "type": "integer"
        },
        "sprite_pointers": {
          "description": "SPR0PT-SPR7PT, assembled from their high and low words.",
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          }
        }
      }
    }
  }
}
