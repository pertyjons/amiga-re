{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amiga-re.invalid/schemas/operations/v1/operations/env.boot.info.request.schema.json",
  "title": "env.boot.info request",
  "description": "Report what a floppy's boot block declares about itself, writing nothing. `read_only`. A checksum that does not verify is a warning, not a refusal: the filesystem does not depend on it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operation",
    "arguments"
  ],
  "properties": {
    "operation": {
      "const": "env.boot.info"
    },
    "arguments": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source"
      ],
      "properties": {
        "source": {
          "$ref": "https://amiga-re.invalid/schemas/operations/v1/common.schema.json#/$defs/sourceLocator"
        },
        "maximum_input_bytes": {
          "$ref": "https://amiga-re.invalid/schemas/operations/v1/common.schema.json#/$defs/maximumInputBytes",
          "default": 67108864
        }
      }
    }
  },
  "examples": [
    {
      "operation": "env.boot.info",
      "arguments": {
        "source": {
          "kind": "file",
          "path": "original/disk1.adf"
        }
      }
    }
  ]
}
