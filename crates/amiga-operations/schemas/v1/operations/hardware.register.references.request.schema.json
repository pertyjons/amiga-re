{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amiga-re.invalid/schemas/operations/v1/operations/hardware.register.references.request.schema.json",
  "title": "hardware.register.references request",
  "description": "Report every custom-chip register a hunk's code touches, and how. Writes nothing. `read_only`.",
  "type": "object",
  "additionalProperties": false,
  "required": ["operation", "arguments"],
  "properties": {
    "operation": { "const": "hardware.register.references" },
    "arguments": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source"],
      "properties": {
        "source": {
          "$ref": "https://amiga-re.invalid/schemas/operations/v1/common.schema.json#/$defs/sourceLocator"
        },
        "hunk": { "description": "CODE hunk to analyze.", "type": "integer", "minimum": 0, "default": 0 },
        "entries": {
          "description": "Where the traversal starts, as hunk offsets. Defaults to offset 0.",
          "type": "array",
          "items": { "type": "integer", "minimum": 0, "maximum": 4294967295 }
        },
        "origin": {
          "description": "The address the hunk is mapped at.",
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "maximum_accesses": {
          "$ref": "https://amiga-re.invalid/schemas/operations/v1/common.schema.json#/$defs/resultCap"
        },
        "maximum_input_bytes": {
          "$ref": "https://amiga-re.invalid/schemas/operations/v1/common.schema.json#/$defs/maximumInputBytes",
          "default": 67108864
        }
      }
    }
  },
  "examples": [
    {
      "operation": "hardware.register.references",
      "arguments": { "source": { "kind": "file", "path": "extracted/game" }, "origin": 65536 }
    }
  ]
}
