{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amiga-re.invalid/schemas/operations/v1/operations/env.sandbox.timeline.export.response.schema.json",
  "title": "env.sandbox.timeline.export result",
  "description": "The timeline, plus what would be written and whether it was. A `prepared` response and a `conflict` response both carry the plan with `committed: false`; the envelope's status says which happened.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "result",
    "plan",
    "committed"
  ],
  "properties": {
    "result": {
      "description": "The timeline itself, exactly as `env.sandbox.timeline` reports it.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "hunk",
        "base_recipe_sha256",
        "steps_total",
        "steps_ran",
        "steps_refused",
        "steps_not_run",
        "instructions_executed_total",
        "maximum_total_steps",
        "budget_exhausted",
        "interrupts_total",
        "interrupts_truncated",
        "steps",
        "final_exports"
      ],
      "properties": {
        "source": {
          "$ref": "https://amiga-re.invalid/schemas/operations/v1/common.schema.json#/$defs/sourcePin",
          "description": "The image the timeline ran over."
        },
        "hunk": {
          "description": "Which CODE hunk it ran.",
          "type": "integer",
          "minimum": 0
        },
        "base_recipe_sha256": {
          "description": "The shared recipe's digest: what says which machine these are steps of.",
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "steps_total": {
          "description": "Steps the request stated.",
          "type": "integer",
          "minimum": 0
        },
        "steps_ran": {
          "description": "Steps that executed, whether or not their routine returned.",
          "type": "integer",
          "minimum": 0
        },
        "steps_refused": {
          "description": "Steps refused before executing anything.",
          "type": "integer",
          "minimum": 0
        },
        "steps_not_run": {
          "description": "Steps never attempted, because the aggregate budget was spent or an earlier step did not run.",
          "type": "integer",
          "minimum": 0
        },
        "instructions_executed_total": {
          "description": "Instructions the whole timeline executed. Named for what it counts, because `steps` here means the timeline's steps and not the CPU's.",
          "type": "integer",
          "minimum": 0
        },
        "maximum_total_steps": {
          "description": "The aggregate budget this timeline ran under, after clamping.",
          "type": "integer",
          "minimum": 0
        },
        "budget_exhausted": {
          "description": "Whether the aggregate budget stopped the timeline short.",
          "type": "boolean"
        },
        "interrupts_total": {
          "description": "Interrupt deliveries made across every step, including rows past the retention cap.",
          "type": "integer",
          "minimum": 0
        },
        "interrupts_truncated": {
          "description": "Whether the per-step delivery lists omit rows past the timeline-wide cap of 256.",
          "type": "boolean"
        },
        "steps": {
          "description": "Every step, in the order the request stated them.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "outcome",
              "resumed",
              "returned",
              "steps_executed",
              "changed_regions",
              "changed_regions_total",
              "changed_regions_truncated",
              "interrupts_delivered",
              "interrupts_total",
              "interrupts_truncated",
              "checkpoints",
              "diagnostics"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "outcome": {
                "description": "ran: it executed, and `stop` says how it ended. refused: it was refused before executing anything, and `diagnostics` says why. not_run: it was never attempted \u2014 either the aggregate budget was already too small for this step's own, or an earlier step was refused or did not run, and a timeline does not continue past one, because every step after it would run against a machine the request never described.",
                "type": "string",
                "enum": [
                  "ran",
                  "refused",
                  "not_run"
                ]
              },
              "notes": {
                "description": "What this step is for, as the request stated it. Never interpreted.",
                "type": "string"
              },
              "resumed": {
                "description": "Whether this step continued the previous one rather than entering a routine. What makes the sequence readable as a sequence.",
                "type": "boolean"
              },
              "entry": {
                "description": "The absolute address the step started executing at. Present when it ran.",
                "type": "integer",
                "minimum": 0,
                "maximum": 4294967295
              },
              "inputs": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "d",
                  "a",
                  "usp",
                  "ssp",
                  "pc",
                  "sr"
                ],
                "properties": {
                  "d": {
                    "type": "array",
                    "minItems": 8,
                    "maxItems": 8,
                    "items": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 4294967295
                    }
                  },
                  "a": {
                    "type": "array",
                    "minItems": 7,
                    "maxItems": 7,
                    "items": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 4294967295
                    }
                  },
                  "usp": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 4294967295
                  },
                  "ssp": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 4294967295
                  },
                  "pc": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 4294967295
                  },
                  "sr": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 65535
                  }
                },
                "description": "The register file the step started with."
              },
              "outputs": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "d",
                  "a",
                  "usp",
                  "ssp",
                  "pc",
                  "sr"
                ],
                "properties": {
                  "d": {
                    "type": "array",
                    "minItems": 8,
                    "maxItems": 8,
                    "items": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 4294967295
                    }
                  },
                  "a": {
                    "type": "array",
                    "minItems": 7,
                    "maxItems": 7,
                    "items": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 4294967295
                    }
                  },
                  "usp": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 4294967295
                  },
                  "ssp": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 4294967295
                  },
                  "pc": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 4294967295
                  },
                  "sr": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 65535
                  }
                },
                "description": "The register file it left, which is what the next step continues from."
              },
              "stop": {
                "description": "Why the step stopped. Every variant is a distinct fact about the code, not a shade of failure. `breakpoint` is this operation's own: execution reached an address the step named in stop_at, and the instruction there has not executed.",
                "type": "object",
                "required": [
                  "reason"
                ],
                "properties": {
                  "reason": {
                    "type": "string",
                    "enum": [
                      "returned",
                      "step_limit",
                      "stopped",
                      "fault",
                      "trap",
                      "watch",
                      "unhandled_call",
                      "breakpoint"
                    ]
                  },
                  "address": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 4294967295
                  },
                  "access": {
                    "type": "string",
                    "enum": [
                      "read",
                      "write"
                    ]
                  },
                  "size": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 4
                  },
                  "site": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 4294967295
                  },
                  "vector": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 255
                  },
                  "offset": {
                    "description": "The signed library-vector offset. Naming it against an fd table is the frontend's, because the tables are its configuration.",
                    "type": "integer"
                  }
                }
              },
              "returned": {
                "description": "Whether the step's routine returned to the marker. Always false for a step that did not run, which is why `outcome` is what a reader counts rather than this.",
                "type": "boolean"
              },
              "steps_executed": {
                "description": "Instructions this step executed.",
                "type": "integer",
                "minimum": 0
              },
              "changed_regions": {
                "description": "Every run of memory this step's execution changed, digested rather than carried. The step's own seeds are applied before its baseline is taken, so they are inputs here rather than effects; the sandbox stack is excluded, as it is from a call record, because it is the machine's own scratch and would make every step differ for reasons that say nothing about the routine.",
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "address",
                    "length",
                    "sha256"
                  ],
                  "properties": {
                    "address": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 4294967295
                    },
                    "length": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    }
                  }
                }
              },
              "changed_regions_total": {
                "description": "Runs of changed memory this step produced before the report cap.",
                "type": "integer",
                "minimum": 0
              },
              "changed_regions_truncated": {
                "description": "Whether the reported runs are a prefix.",
                "type": "boolean"
              },
              "memory_seeds": {
                "description": "The bytes this step's seeds wrote, so a reader can see what was injected between two ticks without opening the request.",
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "address",
                    "hex"
                  ],
                  "properties": {
                    "address": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 4294967295
                    },
                    "hex": {
                      "type": "string",
                      "pattern": "^([0-9a-f]{2})*$"
                    },
                    "from": {
                      "description": "Where the bytes came from, when the seed named a range or a pinned artifact rather than spelling them out.",
                      "type": "object"
                    }
                  }
                }
              },
              "checkpoints": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "name",
                    "address",
                    "length",
                    "sha256"
                  ],
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "address": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 4294967295
                    },
                    "length": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 4294967295
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    }
                  }
                },
                "description": "The named ranges of memory as this step left them, digested."
              },
              "diagnostics": {
                "description": "Why this step was refused. Empty unless `outcome` is `refused`.",
                "type": "array",
                "items": {
                  "$ref": "https://amiga-re.invalid/schemas/operations/v1/diagnostic.schema.json"
                }
              },
              "trace": {
                "description": "This step's own trace rows, when the shared recipe asked for a trace. Per step rather than one run of them, because a timeline's whole claim is that its steps are separable: a single concatenated trace would lose the boundaries that say which tick an instruction belongs to.",
                "type": "array",
                "items": {
                  "$ref": "https://amiga-re.invalid/schemas/operations/v1/common.schema.json#/$defs/sandboxStep"
                }
              },
              "trace_total": {
                "description": "Rows this step would have traced. Always the true total, so a capped trace never reads as a short step.",
                "type": "integer",
                "minimum": 0
              },
              "trace_truncated": {
                "type": "boolean"
              },
              "watch_events_total": {
                "description": "Accesses that matched a watched range, counted across the whole run. Not the same as the number of watch_hits the trace carries: the trace is capped in rows, retention is capped in events, and an attached device can make one instruction produce more matching accesses than a run makes instructions. This is the true total either way.",
                "type": "integer",
                "minimum": 0
              },
              "watch_events_truncated": {
                "description": "Whether more accesses matched than were retained, so the watch_hits on the trace rows are a prefix rather than the whole set.",
                "type": "boolean"
              },
              "interrupts_delivered": {
                "description": "Interrupts delivered while this step ran, in global schedule order, under the timeline-wide cap of 256.",
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "index",
                    "step",
                    "handler",
                    "resume"
                  ],
                  "properties": {
                    "index": {
                      "description": "Which entry of the request's schedule delivered.",
                      "type": "integer",
                      "minimum": 0
                    },
                    "step": {
                      "description": "The schedule's instruction count across the whole timeline when delivery occurred.",
                      "type": "integer",
                      "minimum": 0
                    },
                    "handler": {
                      "description": "The handler address resolved at delivery.",
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 4294967295
                    },
                    "resume": {
                      "description": "The address interrupted, which is where the handler returned.",
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 4294967295
                    }
                  }
                }
              },
              "interrupts_total": {
                "description": "Deliveries made while this step ran, including rows past the shared cap.",
                "type": "integer",
                "minimum": 0
              },
              "interrupts_truncated": {
                "description": "Whether this step delivered rows that the shared cap could not retain.",
                "type": "boolean"
              }
            }
          }
        },
        "final_registers": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "d",
            "a",
            "usp",
            "ssp",
            "pc",
            "sr"
          ],
          "properties": {
            "d": {
              "type": "array",
              "minItems": 8,
              "maxItems": 8,
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4294967295
              }
            },
            "a": {
              "type": "array",
              "minItems": 7,
              "maxItems": 7,
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4294967295
              }
            },
            "usp": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            "ssp": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            "pc": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            "sr": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            }
          },
          "description": "The register file the last step that ran left behind."
        },
        "final_exports": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "address",
              "length",
              "sha256"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "address": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4294967295
              },
              "length": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4294967295
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          },
          "description": "The shared recipe's memory_exports, digested against the machine the whole timeline left."
        },
        "custom_chips": {
          "description": "The custom-chip configuration this call ran under, as normalization resolved it. Absent when none was asked for. The record says what drew the pixels: a response carrying the bytes and not the chipset would be a picture nobody could reproduce.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "chipset",
            "blitter"
          ],
          "properties": {
            "chipset": {
              "type": "string",
              "enum": [
                "ocs"
              ]
            },
            "blitter": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "mode"
              ],
              "properties": {
                "mode": {
                  "type": "string",
                  "enum": [
                    "emulate",
                    "shadow"
                  ]
                },
                "dma": {
                  "description": "Absent under shadow mode, where it had no effect: reporting a policy that did not apply would be a claim.",
                  "type": "string",
                  "enum": [
                    "assume_enabled",
                    "require_enabled"
                  ]
                },
                "maximum_words": {
                  "description": "Absent under shadow mode, for the same reason as dma.",
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        },
        "blits": {
          "description": "The blits the whole timeline performed or refused, capped. At the timeline's level rather than at each step's, because the blitter is one device driven by one machine: its own retention cap is run-wide, so a per-step split would report a prefix under each step and let a reader add them up into a number no run had.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "index",
              "width",
              "height",
              "bltcon0",
              "bltcon1",
              "initial_pointers",
              "final_pointers",
              "datapath_words",
              "words_written",
              "dma_assumed"
            ],
            "properties": {
              "index": {
                "description": "Position in the run, counting refused blits.",
                "type": "integer",
                "minimum": 0
              },
              "width": {
                "description": "Words per row, decoded from BLTSIZE, where a field of zero means 64.",
                "type": "integer",
                "minimum": 1,
                "maximum": 64
              },
              "height": {
                "description": "Rows, decoded from BLTSIZE, where a field of zero means 1024.",
                "type": "integer",
                "minimum": 1,
                "maximum": 1024
              },
              "bltcon0": {
                "type": "integer",
                "minimum": 0,
                "maximum": 65535
              },
              "bltcon1": {
                "type": "integer",
                "minimum": 0,
                "maximum": 65535
              },
              "initial_pointers": {
                "description": "The A, B, C and D channel pointers when the blit was triggered.",
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 4294967295
                },
                "minItems": 4,
                "maxItems": 4
              },
              "final_pointers": {
                "description": "And afterwards. Equal to initial_pointers when the blit was refused: a blit that did not happen cannot have advanced a pointer.",
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 4294967295
                },
                "minItems": 4,
                "maxItems": 4
              },
              "datapath_words": {
                "description": "width times height: what the blit cost the budget, whether or not it ran.",
                "type": "integer",
                "minimum": 1
              },
              "words_written": {
                "description": "Words the destination channel wrote. Zero when USED was clear or the blit was refused.",
                "type": "integer",
                "minimum": 0
              },
              "zero": {
                "description": "BZERO: whether every word the datapath produced was zero. Absent when no blit ran, because reporting false there would be a claim.",
                "type": "boolean"
              },
              "dma_assumed": {
                "description": "Whether the blit ran with DMACON saying blitter DMA was off.",
                "type": "boolean"
              },
              "refused": {
                "description": "Why the blit did not run, if it did not.",
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "message"
                ],
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "line_mode",
                      "unmapped",
                      "address_overflow",
                      "dma_disabled",
                      "budget_exceeded"
                    ]
                  },
                  "channel": {
                    "type": "string",
                    "enum": [
                      "a",
                      "b",
                      "c",
                      "d"
                    ]
                  },
                  "address": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 4294967295
                  },
                  "message": {
                    "description": "For a reader. A consumer reads the structured fields beside it.",
                    "type": "string"
                  }
                }
              },
              "observations": {
                "description": "What is true about this blit that a reader needs in order to distrust the right pixel. Needs no cap: it is bounded by the number of things one blit can be unusual about.",
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "occurrences"
                  ],
                  "properties": {
                    "kind": {
                      "description": "A stable name for what was observed: ecs_register_written, reserved_control_bit, both_fill_modes, fill_without_descending, destination_overlaps_source, immediate_data_shift_changed.",
                      "type": "string"
                    },
                    "register": {
                      "description": "The register offset it is about, when it is about one.",
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 65535
                    },
                    "channel": {
                      "description": "The blitter channel it is about, when it is about one.",
                      "type": "string",
                      "enum": [
                        "a",
                        "b",
                        "c",
                        "d"
                      ]
                    },
                    "occurrences": {
                      "description": "How many times it happened. Run-level observations are aggregated by (kind, register) rather than accumulated, so a program writing one register in a loop is one row with a count rather than a million rows.",
                      "type": "integer",
                      "minimum": 1
                    }
                  }
                }
              }
            }
          }
        },
        "blits_total": {
          "description": "Blits triggered, refused ones included. Always the true total, so a capped list never reads as a short run.",
          "type": "integer",
          "minimum": 0
        },
        "attempted_blit_words_total": {
          "description": "Datapath words every triggered blit asked for, refusals included: what the budget was charged. Refusals are charged because the preflight that refuses one is itself proportional to the blit.",
          "type": "integer",
          "minimum": 0
        },
        "executed_blit_words_total": {
          "description": "Datapath words the blits that actually ran performed. Two named fields rather than one described as both, so a run that spent its budget on refusals is legible as exactly that.",
          "type": "integer",
          "minimum": 0
        },
        "chip_observations": {
          "description": "Run-level chip observations, aggregated by kind and register. Bounded by construction: a finite key means a program writing one register in a loop cannot grow this list.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "occurrences"
            ],
            "properties": {
              "kind": {
                "description": "A stable name for what was observed: ecs_register_written, reserved_control_bit, both_fill_modes, fill_without_descending, destination_overlaps_source, immediate_data_shift_changed.",
                "type": "string"
              },
              "register": {
                "description": "The register offset it is about, when it is about one.",
                "type": "integer",
                "minimum": 0,
                "maximum": 65535
              },
              "channel": {
                "description": "The blitter channel it is about, when it is about one.",
                "type": "string",
                "enum": [
                  "a",
                  "b",
                  "c",
                  "d"
                ]
              },
              "occurrences": {
                "description": "How many times it happened. Run-level observations are aggregated by (kind, register) rather than accumulated, so a program writing one register in a loop is one row with a count rather than a million rows.",
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    },
    "plan": {
      "$ref": "https://amiga-re.invalid/schemas/operations/v1/common.schema.json#/$defs/writePlan"
    },
    "committed": {
      "type": "boolean"
    }
  }
}
