{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amiga-re.invalid/schemas/operations/v1/operations/env.boot.trace.response.schema.json",
  "title": "env.boot.trace result",
  "description": "The calls the boot code made, the registers it wrote, the tracks it read, and how it stopped.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source",
    "boot",
    "load_address",
    "entry",
    "exec_base",
    "io_request",
    "stop",
    "steps_executed",
    "chip_writes",
    "chip_writes_total",
    "chip_writes_truncated",
    "exec_calls",
    "watch_hits",
    "watch_events_total",
    "watch_events_truncated",
    "served_reads",
    "bytes_served"
  ],
  "properties": {
    "source": {
      "$ref": "https://amiga-re.invalid/schemas/operations/v1/common.schema.json#/$defs/sourcePin"
    },
    "boot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "tag",
        "flags",
        "is_dos",
        "filesystem",
        "stored_checksum",
        "checksum_valid",
        "root_block",
        "has_boot_code",
        "boot_code_bytes"
      ],
      "properties": {
        "source": {
          "$ref": "https://amiga-re.invalid/schemas/operations/v1/common.schema.json#/$defs/sourcePin"
        },
        "tag": {
          "description": "The three-character tag, as text. DOS for an AmigaDOS disk.",
          "type": "string"
        },
        "flags": {
          "description": "The fourth tag byte: the filesystem flags.",
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "is_dos": {
          "description": "Whether the tag is DOS. A disk that is not is usually a trackloader.",
          "type": "boolean"
        },
        "filesystem": {
          "type": "string",
          "enum": [
            "OFS",
            "FFS"
          ]
        },
        "stored_checksum": {
          "description": "The checksum as stored. Reported beside whether it verifies rather than as a pass or a fail: a custom-boot disk with a deliberately wrong checksum is a normal thing to find, and a result that only said invalid would lose the number that recognizes it.",
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "checksum_valid": {
          "type": "boolean"
        },
        "root_block": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "has_boot_code": {
          "description": "Whether the boot code area holds anything but zeroes.",
          "type": "boolean"
        },
        "boot_code_bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "load_address": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "entry": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "exec_base": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "io_request": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "stop": {
      "description": "Why the run stopped. Every variant is a distinct fact about the code, not a shade of failure.",
      "type": "object",
      "required": [
        "reason"
      ],
      "properties": {
        "reason": {
          "type": "string",
          "enum": [
            "returned",
            "step_limit",
            "stopped",
            "fault",
            "trap",
            "watch",
            "unhandled_call"
          ]
        },
        "address": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "access": {
          "type": "string",
          "enum": [
            "read",
            "write"
          ]
        },
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "site": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "vector": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "offset": {
          "description": "The signed library-vector offset. Naming it against an fd table is the frontend's, because the tables are its configuration.",
          "type": "integer"
        }
      }
    },
    "steps_executed": {
      "type": "integer",
      "minimum": 0
    },
    "chip_writes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "address",
          "value"
        ],
        "properties": {
          "address": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          },
          "register": {
            "description": "The register's name, when the chip map knows one. Hardware knowledge, not configuration, so it belongs in the answer rather than in whichever frontend renders it.",
            "type": "string"
          },
          "value": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65535
          }
        }
      }
    },
    "chip_writes_total": {
      "description": "Custom-chip register writes the boot code made, counted across the whole boot. Not the same as the length of chip_writes: retention is capped, and a loader that writes a register in a loop is exactly the case where the count matters and the thousandth repetition does not.",
      "type": "integer",
      "minimum": 0
    },
    "chip_writes_truncated": {
      "description": "Whether more registers were written than are reported, so chip_writes is a prefix rather than the whole set.",
      "type": "boolean"
    },
    "exec_calls": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "site",
          "offset"
        ],
        "properties": {
          "site": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          },
          "offset": {
            "description": "The signed library-vector offset. Ground truth of which OS calls were made, unlike a static disassembly's guess. Named by an fd table, which is the frontend's configuration.",
            "type": "integer"
          }
        }
      }
    },
    "watch_hits": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "address",
          "access",
          "size",
          "before",
          "after"
        ],
        "properties": {
          "address": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          },
          "access": {
            "type": "string",
            "enum": [
              "read",
              "write"
            ]
          },
          "size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4
          },
          "before": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          },
          "after": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          }
        }
      }
    },
    "watch_events_total": {
      "description": "Accesses that matched a watched range, counted across the whole boot. Not the same as the length of watch_hits: the hits are gathered from the retained trace rows, and both retention and the trace are capped.",
      "type": "integer",
      "minimum": 0
    },
    "watch_events_truncated": {
      "description": "Whether more accesses matched than were retained, so watch_hits is a prefix rather than the whole set.",
      "type": "boolean"
    },
    "served_reads": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "index",
          "command",
          "offset",
          "destination",
          "requested",
          "actual",
          "status"
        ],
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0
          },
          "command": {
            "type": "string"
          },
          "offset": {
            "type": "integer",
            "minimum": 0
          },
          "destination": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          },
          "requested": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          },
          "actual": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          },
          "status": {
            "description": "The io_Error status the request was left with. Zero is success.",
            "type": "integer"
          }
        }
      }
    },
    "bytes_served": {
      "type": "integer",
      "minimum": 0
    }
  }
}
