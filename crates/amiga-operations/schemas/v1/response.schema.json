    },
    "result": {
      "description": "When present, the payload must match the operation. Errors may retain a verification report or an uncommitted write plan."
    }
  },
  "allOf": [
    {
      "description": "A successful operation must carry its result.",
      "if": {
        "properties": {
          "status": {
            "const": "success"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "result"
        ]
      }
    },
    {
      "description": "A failed operation must carry at least one error diagnostic. Any retained result is still validated against its operation.",
      "if": {
        "properties": {
          "status": {
            "const": "error"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "diagnostics": {
            "contains": {
              "properties": {
                "severity": {
                  "const": "error"
                }
              },
              "required": [
                "severity"
              ]
            }
          }
        }
      }
    },
    {
      "description": "Cancelled operations carry no authoritative result.",
      "if": {
        "properties": {
          "status": {
            "const": "cancelled"
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "result"
          ]
        }
      }
    }
  ],
